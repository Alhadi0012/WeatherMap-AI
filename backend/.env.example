# Copy this file to  .env  and fill in your key.
# backend/.env is listed in .gitignore and must never be committed.

# Google AI Studio key - https://aistudio.google.com  (free tier)
GEMINI_KEY=

# Model name. gemini-2.5-flash is no longer offered to new accounts.
GEMINI_MODEL=gemini-3.8-flash

# Port for the whole app (frontend + API)
PORT=3000
